# --- GitHub App ---
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# The App's private key. Locally, point at the downloaded .pem file:
GITHUB_PRIVATE_KEY_PATH=private-key.pem
# When deployed (no filesystem for a .pem), paste the key contents instead.
# Literal \n sequences are converted back to real newlines.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"

# --- LLM ---
# Groq (OpenAI-compatible, fast + cheap). If this is set, Groq is used.
GROQ_API_KEY=gsk_...
SENTINEL_MODEL=llama-3.3-70b-versatile

# Or use OpenAI instead (leave GROQ_API_KEY unset):
# OPENAI_API_KEY=sk-...
# SENTINEL_MODEL=gpt-4o

# Any other OpenAI-compatible provider (Together, OpenRouter, local server):
# LLM_BASE_URL=https://...

# --- Storage (optional) ---
# Defaults to data/sentinel.db locally, /tmp/sentinel.db on serverless.
# SENTINEL_DB_FILE=data/sentinel.db
